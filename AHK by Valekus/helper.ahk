vu1(State1)
{
If state1
{
Gui Destroy
CustomColor3 = EEAA99
Gui +LastFound +AlwaysOnTop -Caption +ToolWindow 
Gui, Color, black
Gui, Font, s7
Gui, Font, cWhite
Gui, Font, w%Скорость1%0
GUI, ADD, TEXT,,     <-----Внутренний устав ОВД----->
GUI, ADD, TEXT,,     Глава 1. Основные положения
GUI, ADD, TEXT,,     1.1 Данный устав должен знать каждый сотрудник, независимо от звания и должности;
GUI, ADD, TEXT,,     1.2 За нарушение данного устава, сотрудник полиции может получить наказание, начиная от устного предупреждения и заканчивая увольнением, с последующий внесением в чёрный список;
GUI, ADD, TEXT,,     1.3 Незнание данного устава не освобождает от ответственности;
GUI, ADD, TEXT,,     1.4 Руководство в управлениях органов внутренних дел осуществляет начальник, а также его заместители;
GUI, ADD, TEXT,,     1.5 Руководство организации по необходимости имеет право самостоятельно назначать меру наказания.
GUI, ADD, TEXT,,     ______________________________________________________________________________________________________________________________________________________________________________
GUI, ADD, TEXT,,     Глава 2. Обязанности сотрудников полиции
GUI, ADD, TEXT,,     2.1 Сотрудник обязан соблюдать устав органов внутренних дел;
GUI, ADD, TEXT,,     2.2 Сотрудник обязан защищать законные права и интересы граждан, лиц без гражданства, иностранных граждан;
GUI, ADD, TEXT,,     2.3 Сотрудник обязан соблюдать субординацию к сослуживцам, сотрудникам других государственных организаций и уважительно относиться ко всем жителям области;
GUI, ADD, TEXT,,     2.4 Сотрудник обязан соблюдать законодательство Нижегородской области, федеральные законы, федеральное постановление, правила дорожного движения, УК, КоАП;
GUI, ADD, TEXT,,     2.5 Сотрудник обязан отвечать за совершённые поступки;
GUI, ADD, TEXT,,     2.6 Каждый сотрудник обязан ежедневно являться на рабочее место (( за неактив от 7 дней - увольнение ));
GUI, ADD, TEXT,,     2.7 Содействовать с гражданами, лицам без гражданства, иностранными гражданами, общественными организациями, специализированными структурами в рамках своих полномочий;
GUI, ADD, TEXT,,     2.8 Реагировать на просьбы, требования, обращения, заявления граждан, сотрудников полиции, иных должностных лиц в рамках своих полномочий;
GUI, ADD, TEXT,,     2.9 Сотрудник обязан соблюдать внутренний распорядок своей организации;
GUI, ADD, TEXT,,     2.10 Выполнять законные поручения, распоряжения старшего по специальному званию/должности;
GUI, ADD, TEXT,,     2.11 Сотрудник обязан следить за сохранностью и техническим состоянием транспортного средства, за которым он закреплён;
GUI, ADD, TEXT,,     2.12 Фиксировать и хранить в течение 14 дней доказательства на правонарушения граждан, привлекаемых к юридической ответственности;
GUI, ADD, TEXT,,     2.13 Сотрудники старшего состава, руководство структурных подразделений обязаны фиксировать и хранить доказательства о своей проделанной работе в течение 7 дней;
GUI, ADD, TEXT,,     2.14 Руководство структурных подразделений обязано следить за своим личным составом и своевременно решать все возникающие проблемы в подконтрольном подразделении.

WinSet, TransColor, %CustomColor3% 180
Gui, Show, x5 y10 NoActivate, window. 
}
Else
Gui Destroy
Return
}



vu2(state2)
{
If state2
{
Gui Destroy
CustomColor3 = EEAA99
Gui +LastFound +AlwaysOnTop -Caption +ToolWindow 
Gui, Color, black
Gui, Font, s7
Gui, Font, cWhite
Gui, Font, w%Скорость1%0
GUI, ADD, TEXT,,     Глава 3. Запреты для сотрудников полиции
GUI, ADD, TEXT,,     3.1 Запрещено нарушать законодательство Нижегородской области. Наказание за нарушение: предупреждение/выговор/понижение/увольнение;
GUI, ADD, TEXT,,     3.2 Запрещено выпрашивать у руководства повышения и проверку отчётной деятельности. Наказание за нарушение: предупреждение/выговор/понижение;
GUI, ADD, TEXT,,     3.3 Запрещено заниматься личными делами находясь при исполнении должностных обязанностей. Наказание: предупреждение/выговор;
GUI, ADD, TEXT,,     3.4 Запрещено использовать оружие в личных целях. Наказание за нарушение: понижение/увольнение;
GUI, ADD, TEXT,,     3.5 Запрещено спать в неположенном месте/на посту более 20 минут ((AFK с использованием клавиши “ESC” более 20 минут)). Наказание за нарушение: предупреждение/выговор. Исключение: разрешается спать более 20 минут ((AFK с использованием клавиши “ESC” более 20 минут)) в комнате хранения оружия;
GUI, ADD, TEXT,,     3.6 Запрещено совершение должностным лицом действий, выходящих за пределы его полномочий. Наказание: предупреждение/выговор/понижение/увольнение;
GUI, ADD, TEXT,,     3.7 Запрещено подстрекать, склонять, побуждать в прямой или косвенной форме кого-либо к совершению противоправных действий. Наказание: выговор/понижение/увольнение;
GUI, ADD, TEXT,,     3.8 Запрещено употреблять алкогольные напитки в рабочее время. Наказание: понижение/увольнение;
GUI, ADD, TEXT,,     3.9 Запрещено спать на рабочем месте и/или в рабочее время (( AFK без ESC )). Наказание: выговор/понижение/увольнение;
GUI, ADD, TEXT,,     3.10 Запрещено использовать проблесковые маячки, стробоскопы, СГУ, спец сигналы и иные устройства, позволяющие отступать от некоторых пунктов ПДД и давать преимущество перед другими участниками дорожного движения в личных целях, либо без служебной на то необходимости. Наказание: предупреждение/выговор/понижение;
GUI, ADD, TEXT,,     3.11 Запрещено обманывать или вводить в заблуждение руководство организации и её структурных подразделений. Наказание: выговор/увольнение;
GUI, ADD, TEXT,,     3.12 Запрещено организовывать перекрытие автомобильных дорог (блокпосты) без разрешения старшего и высшего начальствующего состава. Наказание: выговор/увольнение;
GUI, ADD, TEXT,,     3.13 Запрещено разглашать внутреннюю информацию специальных подразделений органов внутренних дел. Наказание: выговор/увольнение;
GUI, ADD, TEXT,,     3.14 Запрещено парковать личный транспорт на служебной парковке. Наказание: предупреждение/выговор;
GUI, ADD, TEXT,,     3.15 Запрещено нарушать стандартизации цветографических схем на служебном транспорте. Наказание: выговор/увольнение. Исключение: ОСН и ОРД, исключительно в однотонные темные цвета;
GUI, ADD, TEXT,,     3.16 Запрещено исполнять служебную деятельность на личном транспортном средстве. Наказание: предупреждение/выговор. Исключение: ОСН и ОРД для проведения оперативно-розыскной деятельности;
GUI, ADD, TEXT,,     3.17 Запрещено использовать шлагбаум на стационарных постах "КАД-7","ЮА-6" и "ТЦА" не по назначению. Наказание: выговор/увольнение. Примечание: назначением является проведение перекрытия автомобильных дорог (блокпост);
GUI, ADD, TEXT,,     3.18 Запрещено устанавливать радары в местах несоответствующих перечню мест установки передвижных средств автоматической фиксации административного регламента ГИБДД. Наказание: выговор/увольнение;
GUI, ADD, TEXT,,     3.19 Запрещено использование служебной формы чужого подразделения. Наказание: выговор. Исключение: начальник управления, заместители начальника управления;
GUI, ADD, TEXT,,     3.20 Запрещено кастомизировать, красить и изменять внешний вид табельного оружия. Наказание: предупреждение/выговор. Исключение: камуфляжный окрас;
GUI, ADD, TEXT,,     3.21 Запрещено нарушение распорядка рабочего дня. Наказание: выговор/увольнение;
GUI, ADD, TEXT,,     3.22 Запрещено въезжать на территорию служебной парковки на личном транспорте. Наказание: предупреждение/выговор;
GUI, ADD, TEXT,,     3.23 Запрещено нарушать порядок развода личного состава. Наказание: предупреждение/выговор;
GUI, ADD, TEXT,,     3.24 Запрещено пользоваться своим служебным положением в личных целях. Наказание: выговор/увольнение;
GUI, ADD, TEXT,,     3.25 Запрещено объявлять транспортное средство в розыск в случаях, непредусмотренных Административным регламентом ГИБДД. Наказание: выговор/увольнение;
GUI, ADD, TEXT,,     3.26 Во время работы запрещено использовать аудиосистему с открытыми окнами автомобиля или музыкальный центр. Наказание: предупреждение/выговор. Исключение: тематическое мероприятие;
GUI, ADD, TEXT,,     3.27 Запрещено вмешиваться и подсказывать ответы во время проведения собеседований и аттестационных комиссий. Наказание: выговор;
GUI, ADD, TEXT,,     3.28 Запрещено целенаправленно осуществлять служебную деятельность на территории автовокзала Батырево. Наказание: увольнение;
GUI, ADD, TEXT,,     3.29 Запрещено осуществлять дежурство на посту в составе более трёх сотрудников полиции. Наказание: выговор;
GUI, ADD, TEXT,,     3.30 Запрещено осуществлять охрану собеседования/призыва в составе более пяти сотрудников полиции. Наказание: выговор;
GUI, ADD, TEXT,,     3.31 Запрещено не соблюдать установленные требования на вступление в организацию и специальные подразделения. Наказание: увольнение;
GUI, ADD, TEXT,,     3.32 Запрещено осуществлять дежурство на посту "ДЧ" со звания сержанта полиции и выше. Наказание: предупреждение/выговор;
GUI, ADD, TEXT,,     3.33 Запрещено проводить более двух занятий в день по тактико-стрелковой подготовке в компьютерном клубе с длительностью более 30 минут. Наказание: выговор/увольнение. Примечание: данные тренировки проводятся исключительно для сотрудников специального подразделения в количестве не менее шести человек;
GUI, ADD, TEXT,,     3.34 Запрещено порочить честь и достоинство сотрудника правоохранительных органов. Наказание: предупреждение/выговор/увольнение;
GUI, ADD, TEXT,,     3.35 Запрещено заходить на территорию СПЗЛ. Наказание: предупреждение/выговор/увольнение. Исключения: сопровождение сотрудников УФСИН и гражданских лиц;
GUI, ADD, TEXT,,     3.36 Запрещено халатное отношение к должностным обязанностям, то есть неисполнение или ненадлежащее исполнение сотрудником своих обязанностей, которое не влечет за собой уголовной ответственности. Наказание: выговор/увольнение;
GUI, ADD, TEXT,,     3.37 Запрещено осуществлять оперативно-розыскную деятельность. Наказание: предупреждение/выговор/увольнение. Исключение: сотрудники УМВД, специализированная рота УГИБДД.

WinSet, TransColor, %CustomColor3% 180
Gui, Show, x5 y10 NoActivate, window. 
}
Else
Gui Destroy
Return
}


vu3(state3)
{
If state3
{
Gui Destroy
CustomColor3 = EEAA99
Gui +LastFound +AlwaysOnTop -Caption +ToolWindow 
Gui, Color, black
Gui, Font, s7
Gui, Font, cWhite
Gui, Font, w%Скорость1%0
GUI, ADD, TEXT,,     Глава 4. Служебная рация
GUI, ADD, TEXT,,     4.1 Рацией можно пользоваться строго в служебных целях. Наказание за нарушение: выговор/увольнение;
GUI, ADD, TEXT,,     4.2 Пользование рацией департамента (( /d )) разрешено строго со звания прапорщик. Наказание за нарушение: предупреждение/выговор/увольнение;
GUI, ADD, TEXT,,     4.3 Запрещено использовать рацию для покупки, продажи и рекламы имущества. Наказание за нарушение: предупреждение/выговор;
GUI, ADD, TEXT,,     4.4 Запрещено нести бред/засорять волну/создавать помехи в рацию. Наказание за нарушение: предупреждение/выговор/увольнение;
GUI, ADD, TEXT,,     4.5 Запрещено игнорировать рацию. Наказание за нарушение: выговор/увольнение;
GUI, ADD, TEXT,,     4.6 Запрещено использовать при разговорах по рации: брань, ругань и оскорбления коллег. Наказание за нарушение: предупреждение/выговор/увольнение;
GUI, ADD, TEXT,,     4.7 Запрещено нарушать порядок докладов в рацию. Наказание: предупреждение/выговор.
GUI, ADD, TEXT,,     ______________________________________________________________________________________________________________________________________________________________________________

GUI, ADD, TEXT,,     Глава 5. Построение личного состава
GUI, ADD, TEXT,,     5.1 Находясь в строю, сотрудникам запрещены разговоры по телефону, рации, выкрики и так далее (( иcключение: ООС чат )). Наказание за нарушение: предупреждение/выговор/увольнение;
GUI, ADD, TEXT,,     5.2 В строю запрещено доставать/держать оружие в руках. Наказание за нарушение: предупреждение/выговор;
GUI, ADD, TEXT,,     5.3 Запрещено спать в строю (( AFK без использования клавиши “ESC” )). Наказание за нарушение: предупреждение/выговор;
GUI, ADD, TEXT,,     5.4 Запрещено не приходить на построение, будучи в области. Наказание за нарушение: выговор/увольнение;
GUI, ADD, TEXT,,     5.5 Запрещено покидать строй без приказа или разрешения. Наказание за нарушение: предупреждение/выговор;
GUI, ADD, TEXT,,     5.6 Запрещено нарушать порядок построения личного состава. Наказание за нарушение: предупреждение/выговор.
GUI, ADD, TEXT,,     ______________________________________________________________________________________________________________________________________________________________________________

GUI, ADD, TEXT,,     Глава 6. Рабочее время
GUI, ADD, TEXT,,     6.1 В случае если работнику нужен перерыв, сотрудник должен предупредить начальника или его заместителей;
GUI, ADD, TEXT,,     6.2 В свободное от работы время (окончание рабочего времени/обеденный перерыв) сотрудники имеют право свободно перемещаться по области;
GUI, ADD, TEXT,,     6.3 С 20:00 до 10:00 (МСК) сотрудники полиции имеют право выполнять служебные обязанности без напарника;
GUI, ADD, TEXT,,     6.4 Обеденный перерыв у сотрудников полиции в период с 13:00 до 14:00 (МСК);
GUI, ADD, TEXT,,     6.5 В рабочее время сотрудник обязан выполнять исключительно служебные обязанности;
GUI, ADD, TEXT,,     6.6 С 10:00 до 20:00 (МСК) сотрудник полиции обязан выполнять служебные обязанности исключительно с напарником;
GUI, ADD, TEXT,,     6.7 Рабочий день сотрудников полиции с понедельника по пятницу длится с 10:00 до 20:00 (МСК). Перерыв длится с 13:00 до 14:00 (МСК);
GUI, ADD, TEXT,,     6.8 Рабочий день сотрудников полиции в субботу и воскресенье длится с 10:00 до 19:00 (МСК). Перерыв длится с 13:00 до 14:00 (МСК);
GUI, ADD, TEXT,,     6.9 В случае чрезвычайных ситуаций график работы переводится на круглосуточный.
GUI, ADD, TEXT,,     ______________________________________________________________________________________________________________________________________________________________________________

GUI, ADD, TEXT,,     Глава 7. Отпуск
GUI, ADD, TEXT,,     7.1 Сотрудникам разрешено уходить в отпуск со звания старшины;
GUI, ADD, TEXT,,     7.2 Максимальный срок отпуска составляет 14 дней (допустимы исключения);
GUI, ADD, TEXT,,     7.3 Во время нахождения в отпуске запрещено вступать в другие организации;
GUI, ADD, TEXT,,     7.4 Во время нахождения в отпуске запрещено нарушать законодательство Нижегородской области, Федеральное постановление, правила дорожного движения, УК, КоАП
WinSet, TransColor, %CustomColor3% 180

Gui, Show, x5 y10 NoActivate, window. 
}
Else
Gui Destroy
Return
}


